# Experiment A4: 0/1 Knapsack using Branch and Bound
# Time Complexity: O(n * 2^n) worst case
# Space Complexity: O(2^n) worst case

import heapq
from itertools import count


def knapsack_branch_bound(values, weights, capacity):

    n = len(values)

    # Sort items by decreasing value-to-weight ratio
    items = sorted(
        [(values[i], weights[i], i) for i in range(n)],
        key=lambda x: x[0] / x[1],
        reverse=True
    )

    # Calculate upper bound using fractional knapsack
    def bound(level, profit, weight):

        if weight > capacity:
            return 0

        total_weight = weight
        upper_value = profit
        j = level

        while j < n and total_weight + items[j][1] <= capacity:
            total_weight += items[j][1]
            upper_value += items[j][0]
            j += 1

        if j < n:
            remaining = capacity - total_weight
            upper_value += (
                items[j][0] * remaining / items[j][1]
            )

        return upper_value

    # Priority queue: highest bound gets processed first
    tie_breaker = count()

    heap = []
    initial_bound = bound(0, 0, 0)

    heapq.heappush(
        heap,
        (-initial_bound, next(tie_breaker), 0, 0, 0, ())
    )

    max_profit = 0
    best_items = ()

    while heap:

        neg_bound, _, level, profit, weight, chosen = heapq.heappop(heap)

        current_bound = -neg_bound

        # Prune branches that cannot improve the solution
        if current_bound <= max_profit:
            continue

        if level == n:
            continue

        value, item_weight, original_index = items[level]

        # Branch 1: Include the current item
        new_weight = weight + item_weight
        new_profit = profit + value

        if new_weight <= capacity:

            new_chosen = chosen + (original_index,)

            if new_profit > max_profit:
                max_profit = new_profit
                best_items = new_chosen

            include_bound = bound(
                level + 1, new_profit, new_weight
            )

            if include_bound > max_profit:
                heapq.heappush(
                    heap,
                    (
                        -include_bound,
                        next(tie_breaker),
                        level + 1,
                        new_profit,
                        new_weight,
                        new_chosen
                    )
                )

        # Branch 2: Exclude the current item
        exclude_bound = bound(level + 1, profit, weight)

        if exclude_bound > max_profit:
            heapq.heappush(
                heap,
                (
                    -exclude_bound,
                    next(tie_breaker),
                    level + 1,
                    profit,
                    weight,
                    chosen
                )
            )

    return max_profit, sorted(best_items)


def main():

    try:
        n = int(input("Enter number of items: "))

        if n < 0:
            print("Number of items cannot be negative.")
            return

        values = []
        weights = []

        for i in range(n):

            value = int(input(f"Enter value of item {i + 1}: "))
            weight = int(input(f"Enter weight of item {i + 1}: "))

            if value < 0 or weight <= 0:
                print("Values must be non-negative and weights positive.")
                return

            values.append(value)
            weights.append(weight)

        capacity = int(input("Enter knapsack capacity: "))

        if capacity < 0:
            print("Capacity cannot be negative.")
            return

        maximum_value, selected = knapsack_branch_bound(
            values, weights, capacity
        )

        print("\nMaximum value:", maximum_value)

        print("\nSelected items:")

        if not selected:
            print("No items selected.")

        for i in selected:
            print(
                f"Item {i + 1}: "
                f"Value = {values[i]}, "
                f"Weight = {weights[i]}"
            )

    except ValueError:
        print("Invalid input. Please enter integers.")


if __name__ == "__main__":
    main()
